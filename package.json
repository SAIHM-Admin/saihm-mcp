{
  "name": "@saihm/mcp-server",
  "version": "0.1.2",
  "mcpName": "io.github.SAIHM-Admin/saihm-mcp",
  "description": "Sovereign, encrypted, persistent memory for AI agents. Eight MCP tools — remember, recall, forget (GDPR Art. 17 erasure), share, governance. Anchored on COTI V2 mainnet. Apache-2.0.",
  "type": "module",
  "main": "dist/saihm_mcp_server.js",
  "types": "dist/saihm_mcp_server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/saihm_mcp_server.d.ts",
      "import": "./dist/saihm_mcp_server.js"
    },
    "./reporting": {
      "types": "./dist/reporting/index.d.ts",
      "import": "./dist/reporting/index.js"
    }
  },
  "bin": {
    "saihm-mcp-server": "dist/saihm_mcp_server.js"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "npm run clean && tsc -p . && chmod +x dist/saihm_mcp_server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "c8 tsx tests/integration.test.ts",
    "test:nocov": "tsx tests/integration.test.ts",
    "start": "node dist/saihm_mcp_server.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "c8": {
    "reporter": ["text", "lcov", "html"],
    "include": ["**/*.ts"],
    "exclude": ["tests/**", "dist/**", "node_modules/**", "coverage/**", "eslint.config.js"],
    "all": true,
    "check-coverage": true,
    "statements": 80,
    "branches": 65,
    "lines": 80,
    "functions": 80
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "saihm",
    "agent-memory",
    "sovereign-memory",
    "claude-code"
  ],
  "license": "Apache-2.0",
  "author": "SAIHM",
  "homepage": "https://saihm.coti.global",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAIHM-Admin/saihm-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/SAIHM-Admin/saihm-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@noble/hashes": "^1.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "c8": "^11.0.0",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  }
}
