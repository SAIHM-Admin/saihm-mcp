{
  "name": "@saihm/mcp-server",
  "version": "0.3.9",
  "mcpName": "io.github.SAIHM-Admin/saihm-mcp",
  "description": "The open MCP client for SAIHM sovereign agent memory — eight tools (remember · recall · forget · share · govern) any MCP agent uses to reach a SAIHM operator endpoint. Implements the publicly documented SAIHM memory protocol (specified in an Internet-Draft; not an IETF standard). For production client-side post-quantum sealing, pair with @saihm/client-pro. Evaluate it offline first with the runnable cross-model demos — no account. Apache-2.0.",
  "type": "module",
  "main": "dist/saihm_mcp_server.js",
  "types": "dist/saihm_mcp_server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/saihm_mcp_server.d.ts",
      "import": "./dist/saihm_mcp_server.js"
    },
    "./reporting": {
      "types": "./dist/reporting/index.d.ts",
      "import": "./dist/reporting/index.js"
    }
  },
  "bin": {
    "saihm-mcp-server": "dist/saihm_mcp_server.js"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "npm run clean && tsc -p . && chmod +x dist/saihm_mcp_server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "c8 tsx tests/integration.test.ts",
    "test:nocov": "tsx tests/integration.test.ts",
    "start": "node dist/saihm_mcp_server.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "c8": {
    "reporter": [
      "text",
      "lcov",
      "html"
    ],
    "include": [
      "**/*.ts"
    ],
    "exclude": [
      "tests/**",
      "dist/**",
      "node_modules/**",
      "coverage/**",
      "eslint.config.js"
    ],
    "all": true,
    "check-coverage": true,
    "statements": 80,
    "branches": 65,
    "lines": 80,
    "functions": 80
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "saihm",
    "agent-memory",
    "sovereign-memory",
    "persistent-memory",
    "ai-agents",
    "claude-code",
    "claude-desktop",
    "cursor",
    "gdpr"
  ],
  "license": "Apache-2.0",
  "author": "SAIHM",
  "homepage": "https://saihm.coti.global",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/SAIHM-Admin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAIHM-Admin/saihm-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/SAIHM-Admin/saihm-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@noble/hashes": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "c8": "^11.0.0",
    "eslint": "^10.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  }
}
